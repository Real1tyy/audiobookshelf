{
  "name": "audiobookshelf",
  "version": "2.40.0",
  "buildNumber": 1,
  "description": "Self-hosted audiobook and podcast server",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch index.js -- --dev",
    "start": "tsx index.js",
    "start:node": "node index.js",
    "start-dev": "node index.js --prod-with-dev-env",
    "client": "cd client && npm ci && npm run generate",
    "prod": "npm run client && npm ci && node index.js",
    "build-win": "npm run client && pkg -t node20-win-x64 -o ./dist/win/audiobookshelf -C GZip .",
    "build-win-no-compress": "npm run client && pkg -t node20-win-x64 -o ./dist/win/audiobookshelf .",
    "build-linux": "build/linuxpackager",
    "docker": "docker buildx build --platform linux/amd64,linux/arm64 --push .  -t advplyr/audiobookshelf",
    "docker-amd64-local": "docker buildx build --platform linux/amd64 --load .  -t advplyr/audiobookshelf-amd64-local",
    "docker-arm64-local": "docker buildx build --platform linux/arm64 --load .  -t advplyr/audiobookshelf-arm64-local",
    "deploy-linux": "node deploy/linux",
    "test": "mocha",
    "coverage": "nyc mocha",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch"
  },
  "bin": "index.js",
  "pkg": {
    "assets": [
      "client/dist/**/*",
      "node_modules/sqlite3/lib/binding/**/*.node",
      "server/migrations/*.js"
    ],
    "scripts": [
      "index.js",
      "server/**/*.js"
    ]
  },
  "mocha": {
    "recursive": true,
    "require": [
      "tsx/cjs"
    ]
  },
  "author": "advplyr",
  "license": "GPL-3.0",
  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "archiver": "^7.0.1",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "date-and-time": "^4.3.0",
    "express": "^4.17.1",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.17.3",
    "fast-sort": "^3.4.1",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.3.4",
    "graceful-fs": "^4.2.10",
    "htmlparser2": "^8.0.1",
    "image-type": "4.1.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^10.0.3",
    "memorystore": "^1.6.7",
    "node-cron": "^4.2.1",
    "node-ffprobe": "^3.0.0",
    "node-stream-zip": "^1.15.0",
    "node-unrar-js": "^2.0.2",
    "nodemailer": "^6.9.13",
    "openid-client": "^5.6.1",
    "p-throttle": "^4.1.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "read-chunk": "3.2.0",
    "recursive-readdir-async": "^1.3.0",
    "request-ip": "^3.3.0",
    "sanitize-html": "^2.17.1",
    "semver": "^7.6.3",
    "sequelize": "^6.35.2",
    "socket.io": "^4.5.4",
    "sqlite3": "^5.1.7",
    "ssrf-req-filter": "^1.1.0",
    "ua-parser-js": "^2.0.9",
    "umzug": "^3.8.2",
    "watcher": "^2.3.1",
    "which": "^6.0.1",
    "xml2js": "^0.5.0",
    "youtube-transcript-plus": "^1.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.2.3",
    "chai": "^4.3.10",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "sinon": "^17.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
